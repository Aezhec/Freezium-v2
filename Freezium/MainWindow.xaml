<Window x:Class="Freezium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Freezium" Height="420" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OUTER SHELL: Acrylic Simulation + Glow Border             -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Border CornerRadius="12" BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1">
        <!-- Drop shadow simulation via nested border -->
        <Border CornerRadius="12" Background="{StaticResource SurfaceBaseBrush}">
            <Grid>
                <!-- Noise/grain overlay for acrylic simulation -->
                <Rectangle RadiusX="12" RadiusY="12" Opacity="0.02" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,1,1"/>
                                            <RectangleGeometry Rect="2,2,1,1"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush Color="White"/>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Subtle gradient overlay for depth -->
                <Rectangle RadiusX="12" RadiusY="12" Opacity="0.15" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#b080ff" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.3"/>
                            <GradientStop Color="Transparent" Offset="0.8"/>
                            <GradientStop Color="#7138cc" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Main Layout Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- ═════════════════════════════════════════ -->
                    <!-- TITLE BAR                                -->
                    <!-- ═════════════════════════════════════════ -->
                    <Border Grid.Row="0" Background="Transparent" 
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Margin="20,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- App icon dot -->
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource AccentPrimary}" Offset="0"/>
                                            <GradientStop Color="{StaticResource AccentStrong}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="Freezium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontSize="14" FontWeight="SemiBold" 
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                                        VerticalAlignment="Center">
                                <Button x:Name="btnMinimize" Content="─" 
                                        Style="{StaticResource CaptionButton}" 
                                        Click="btnMinimize_Click"/>
                                <Button x:Name="btnClose" Content="✕" 
                                        Style="{StaticResource CloseButton}" 
                                        Click="btnClose_Click" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hairline separator -->
                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" 
                               Fill="#15ffffff" IsHitTestVisible="False"/>

                    <!-- ═════════════════════════════════════════ -->
                    <!-- MAIN CONTENT                             -->
                    <!-- ═════════════════════════════════════════ -->
                    <Grid Grid.Row="1" Margin="24,20,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnStart" Grid.Column="0" 
                                    Content="▶  START PROXY" 
                                    Style="{StaticResource FluentAccentButton}" 
                                    Click="btnStart_Click"/>
                            <Button x:Name="btnStop" Grid.Column="2" 
                                    Content="■  STOP PROXY" 
                                    Style="{StaticResource FluentButton}" 
                                    Click="btnStop_Click"/>
                        </Grid>

                        <!-- Toggle + Info Button -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="cbManipulateWL"
                                      Content="Manipulate Watch List, Follow, Favorite" 
                                      Style="{StaticResource FluentToggle}" 
                                      IsChecked="True" 
                                      Checked="cbManipulateWL_CheckedChanged" 
                                      Unchecked="cbManipulateWL_CheckedChanged"
                                      VerticalAlignment="Center"/>

                            <!-- Info button -->
                            <Button x:Name="btnManipulateInfo"
                                    Width="18" Height="18"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#50b080ff"
                                    Foreground="#b080ff"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    FontFamily="Segoe UI"
                                    Content="i"
                                    IsTabStop="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Width="18" Height="18"
                                                            CornerRadius="9"
                                                            Background="Transparent"
                                                            BorderBrush="#50b080ff"
                                                            BorderThickness="1">
                                                        <TextBlock Text="i"
                                                                   Foreground="#b080ff"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="Segoe UI"
                                                                   FontStyle="Italic"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#20b080ff"/>
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#b080ff"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.ToolTip>
                                    <ToolTip Background="#1e1a24"
                                             BorderBrush="#50b080ff"
                                             BorderThickness="1"
                                             Padding="12,8"
                                             HasDropShadow="True">
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="Manipulate Watch List, Follow, Favorite"
                                                       Foreground="#b080ff"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock TextWrapping="Wrap"
                                                       Foreground="#c8bfd6"
                                                       FontSize="11"
                                                       FontFamily="Segoe UI"
                                                       LineHeight="18">
                                                When <Run Foreground="#b080ff" FontWeight="SemiBold">enabled</Run>, the proxy intercepts outgoing API requests for <Run Foreground="#e0d4f7">Watch List</Run>, <Run Foreground="#e0d4f7">Follow</Run>, and <Run Foreground="#e0d4f7">Favorite</Run> actions and manipulates them before they reach the server, Watch List, Follow, and Favorite will be stored in local.
                                            </TextBlock>
                                            <TextBlock Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="#7a6e8a"
                                                       FontSize="10"
                                                       FontFamily="Segoe UI"
                                                       FontStyle="Italic">
                                                Disable this if you only want the proxy to run without modifying these requests.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>

                        <!-- Log Console -->
                        <Border Grid.Row="4" CornerRadius="10" 
                                Background="#19161d" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1">
                            <Grid>
                                <!-- Console header -->
                                <TextBlock Text="C O N S O L E" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Opacity="0.5" Margin="14,8,0,0"
                                           VerticalAlignment="Top" HorizontalAlignment="Left"
                                           FontFamily="Segoe UI"/>
                                
                                <ScrollViewer Style="{StaticResource FluentScroll}" Margin="0,26,0,0">
                                    <TextBox x:Name="rtbLogs" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="{StaticResource TextMutedBrush}" 
                                             FontFamily="Cascadia Mono, Consolas, Courier New" 
                                             FontSize="11.5" 
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                             AcceptsReturn="True" 
                                             Margin="14,0,14,10"
                                             CaretBrush="Transparent"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═════════════════════════════════════════ -->
                    <!-- STATUS BAR                               -->
                    <!-- ═════════════════════════════════════════ -->
                    <Border Grid.Row="2" Background="#19161d" 
                            CornerRadius="0,0,12,12" Padding="24,0">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle Height="1" VerticalAlignment="Top" 
                                       Fill="#10ffffff" Margin="-24,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" 
                                         Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{StaticResource AccentPrimary}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="lblStatus" Text="Status: Waiting" 
                                           Foreground="{StaticResource TextMutedBrush}" 
                                           FontSize="11.5" FontFamily="Segoe UI" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Version label -->
                            <TextBlock Text="v1.0" FontSize="10" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       Opacity="0.4" HorizontalAlignment="Right" 
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
